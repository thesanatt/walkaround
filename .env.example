# Copy to .env (gitignored). Never commit a key. Real keys look like LLM_<digits>_<secret>.
MODEL_API_KEY=LLM_your_team_id_your_secret
# Optional: Muse Spark Open on Baseten for the second look. The hackathon key (it may call only
# meta-models/muse-spark-open-1026) is tried first, then an account key with meta-models/muse-spark-open.
# With neither, the look falls back to hosted Muse Spark 1.3.
BASETEN_HACKATHON_API_KEY=
# BASETEN_API_KEY=your_baseten_key
